# Port where the Express server will run
PORT=5000

# ----------------------------------------------------
# MySQL Database Configuration
# ----------------------------------------------------
# DB_HOST: عنوان السيرفر (localhost إذا كان على جهازك)
DB_HOST=localhost
# DB_USER: اسم المستخدم الذي لديه صلاحية الوصول لقاعدة البيانات
DB_USER=root
# DB_PASSWORD: كلمة مرور المستخدم. يجب أن تكون مطابقة لكلمة مرور MySQL الخاصة بك
DB_PASSWORD=
# DB_NAME: اسم قاعدة البيانات التي أنشأتها للمشروع
DB_NAME=finance_tracker

# ----------------------------------------------------
# Security Keys
# ----------------------------------------------------
# JWT_SECRET: مفتاح سري طويل وعشوائي لتشفير رموز الوصول (JWT)
# استخدم سلسلة نصية طويلة لزيادة الأمان
JWT_SECRET=a_very_secret_key_that_is_long_and_random_for_security_reasons